# Ollama must use a local URL. Remote hosts are rejected by the application.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=smollm2:360m
MEDIMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: set an alternate database path inside this project.
# MEDIMIND_DB_PATH=data/medimind.sqlite3